rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdminIdentity() { return signedIn() && request.auth.token.email == 'mohamed.mojahead@gmail.com'; }
    function resetRunning() {
      return exists(/databases/$(database)/documents/system_jobs/factory_reset)
        && get(/databases/$(database)/documents/system_jobs/factory_reset).data.status == 'running';
    }
    function isAdmin() { return isAdminIdentity() && !resetRunning(); }
    function isStaff() { return isAdmin(); }
    function isCashier() {
      return signedIn() && !resetRunning()
        && exists(/databases/$(database)/documents/staff_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff_users/$(request.auth.uid)).data.role == 'cashier'
        && get(/databases/$(database)/documents/staff_users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/staff_users/$(request.auth.uid)).data.email == request.auth.token.email;
    }

    function validNewPurchaseInvoice() {
      let supplierId = request.resource.data.get('supplier_id', null);
      let supplierPath = /databases/$(database)/documents/suppliers/$(supplierId);
      return request.resource.data.keys().hasAll([
          'items', 'product_ids', 'total_amount', 'paid_amount', 'remaining_amount', 'status',
          'payment_ids', 'created_by', 'created_at'
        ])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.product_ids is list
        && request.resource.data.total_amount is number
        && request.resource.data.paid_amount is number
        && request.resource.data.remaining_amount is number
        && request.resource.data.paid_amount >= 0
        && request.resource.data.remaining_amount >= 0
        && request.resource.data.paid_amount <= request.resource.data.total_amount
        && request.resource.data.paid_amount + request.resource.data.remaining_amount >= request.resource.data.total_amount - 0.005
        && request.resource.data.paid_amount + request.resource.data.remaining_amount <= request.resource.data.total_amount + 0.005
        && request.resource.data.status in ['paid', 'partial', 'unpaid']
        && ((request.resource.data.status == 'paid' && request.resource.data.remaining_amount <= 0)
          || (request.resource.data.status == 'partial' && request.resource.data.paid_amount > 0 && request.resource.data.remaining_amount > 0)
          || (request.resource.data.status == 'unpaid' && request.resource.data.paid_amount == 0 && request.resource.data.remaining_amount > 0))
        && request.resource.data.payment_ids is list
        && request.resource.data.payment_ids.size() == 0
        && (supplierId == null || (supplierId is string && exists(supplierPath)));
    }

    function validSupplierPaymentUpdate(invoiceId) {
      let paymentIds = request.resource.data.get('payment_ids', []);
      let paymentId = paymentIds[paymentIds.size() - 1];
      let paymentPath = /databases/$(database)/documents/supplier_payments/$(paymentId);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'paid_amount', 'remaining_amount', 'status', 'payment_ids'
        ])
        && paymentIds is list
        && paymentIds.size() == resource.data.payment_ids.size() + 1
        && request.resource.data.paid_amount is number
        && request.resource.data.remaining_amount is number
        && request.resource.data.paid_amount > resource.data.paid_amount
        && request.resource.data.remaining_amount < resource.data.remaining_amount
        && request.resource.data.remaining_amount >= 0
        && request.resource.data.status in ['paid', 'partial', 'unpaid']
        && ((request.resource.data.status == 'paid' && request.resource.data.remaining_amount <= 0)
          || (request.resource.data.status == 'partial' && request.resource.data.paid_amount > 0 && request.resource.data.remaining_amount > 0)
          || (request.resource.data.status == 'unpaid' && request.resource.data.paid_amount == 0 && request.resource.data.remaining_amount > 0))
        && request.resource.data.paid_amount + request.resource.data.remaining_amount >= resource.data.total_amount - 0.005
        && request.resource.data.paid_amount + request.resource.data.remaining_amount <= resource.data.total_amount + 0.005
        && !exists(paymentPath)
        && existsAfter(paymentPath)
        && getAfter(paymentPath).data.purchase_invoice_id == invoiceId
        && getAfter(paymentPath).data.amount == request.resource.data.paid_amount - resource.data.paid_amount;
    }

    function validSupplierPaymentRecord(id) {
      let invoiceId = request.resource.data.get('purchase_invoice_id', null);
      let invoicePath = /databases/$(database)/documents/purchase_invoices/$(invoiceId);
      return request.resource.data.amount is number
        && request.resource.data.amount > 0
        && invoiceId is string
        && existsAfter(invoicePath)
        && getAfter(invoicePath).data.payment_ids.hasAny([id]);
    }

    match /invoices/{id} {
      allow read: if isStaff();
      allow create, delete: if false;
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'customer_id', 'customer_phone', 'customer_phone_digits', 'customer_name_norm'
        ]);
    }
    match /product_families/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /products/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /customers/{id} {
      allow read: if isStaff() || isCashier();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /suppliers/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow delete: if isAdmin();
    }
    // Financial / accounting collections (F37). Audit records are
    // append-mostly: staff may read and create; only admin may correct
    // via compensating docs, never silent rewrites (delete = admin).
    match /cashbox/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['balance', 'updated_at'])
        && request.resource.data.balance is number
        && request.resource.data.balance >= 0;
      allow delete: if isAdmin();
    }
    match /cash_transactions/{id} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.direction in ['in', 'out'];
      allow update, delete: if isAdmin();
    }
    match /inventory_transactions/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /inventory_cost_adjustments/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /invoice_returns/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /customer_credits/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }
    match /customer_credit_transactions/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
    match /supplier_returns/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /customer_loans/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /debt_payments/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }
    match /invoice_debt_summaries/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /customer_summaries/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /supplier_summaries/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /store_stats/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff() && id == 'current';
      allow delete: if isAdmin();
    }
    match /invoice_stats_daily/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff() && id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow delete: if isAdmin();
    }
    match /invoice_stats_monthly/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff() && id.matches('^[0-9]{4}-[0-9]{2}$');
      allow delete: if isAdmin();
    }
    match /purchase_invoices/{id} {
      allow read: if isStaff();
      allow create: if false;
      allow update: if isStaff() && (validSupplierPaymentUpdate(id)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned'])
          && request.resource.data.get('pinned', false) is bool);
      allow delete: if false;
    }
    match /supplier_payments/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && validSupplierPaymentRecord(id);
      allow update, delete: if isAdmin();
    }
    match /supplier_advances/{id} {
      allow read, create, update, delete: if isAdmin();
    }
    match /supplier_advance_transactions/{id} {
      allow read, create, update, delete: if isAdmin();
    }
    match /system_jobs/{id} {
      allow read: if isAdminIdentity() && id == 'factory_reset';
      allow write: if false;
    }
    match /staff_users/{id} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == id);
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
