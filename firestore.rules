rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // FLAG [S2]: least-privilege baseline. Wire Firebase Custom Claims:
    //   admin -> request.auth.token.role == 'admin'
    //   cashier -> request.auth.token.role in ['admin','cashier']
    // Deploy with: firebase deploy --only firestore:rules
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }
    function isStaff() { return signedIn() && request.auth.token.role in ['admin', 'cashier']; }

    function validInvoice() {
      return request.resource.data.customer_name is string
        && request.resource.data.products is list
        && request.resource.data.products.size() > 0;
    }

    function hasFreshInventoryMovement(productId) {
      let purchaseInvoiceId = request.resource.data.get('last_purchase_invoice_id', null);
      let purchasePath = /databases/$(database)/documents/purchase_invoices/$(purchaseInvoiceId);
      let movementId = request.resource.data.get('last_inventory_transaction_id', null);
      let movementIds = request.resource.data.get('last_inventory_transaction_ids', []);
      let movementPath = /databases/$(database)/documents/inventory_transactions/$(movementId);
      return (purchaseInvoiceId is string
          && !exists(purchasePath)
          && existsAfter(purchasePath)
          && getAfter(purchasePath).data.product_ids.hasAny([productId]))
        || (movementId is string && movementIds is list
        && movementIds.hasAny([movementId])
        && !exists(movementPath)
        && existsAfter(movementPath)
        && getAfter(movementPath).data.product_id == productId
        && getAfter(movementPath).data.quantity is number
        && getAfter(movementPath).data.quantity > 0
        && getAfter(movementPath).data.direction in ['in', 'out']);
    }

    function hasFreshCostMovement(productId) {
      let purchaseInvoiceId = request.resource.data.get('last_purchase_invoice_id', null);
      let purchasePath = /databases/$(database)/documents/purchase_invoices/$(purchaseInvoiceId);
      let movementId = request.resource.data.get('last_inventory_transaction_id', null);
      let movementPath = /databases/$(database)/documents/inventory_transactions/$(movementId);
      let movementIds = request.resource.data.get('last_inventory_transaction_ids', []);
      return (purchaseInvoiceId is string
          && !exists(purchasePath)
          && existsAfter(purchasePath)
          && getAfter(purchasePath).data.product_ids.hasAny([productId]))
        || (movementId is string && movementIds is list
        && movementIds.hasAny([movementId])
        && !exists(movementPath)
        && existsAfter(movementPath)
        && getAfter(movementPath).data.product_id == productId
        && getAfter(movementPath).data.direction == 'in'
        && getAfter(movementPath).data.unit_cost is number);
    }

    function hasFreshPurchaseMovement(productId, invoiceId) {
      let invoicePath = /databases/$(database)/documents/purchase_invoices/$(invoiceId);
      return invoiceId is string
        && !exists(invoicePath)
        && existsAfter(invoicePath)
        && getAfter(invoicePath).data.product_ids.hasAny([productId]);
    }

    function hasFreshCostAdjustment(productId) {
      let adjustmentId = request.resource.data.get('last_cost_adjustment_id', null);
      let adjustmentPath = /databases/$(database)/documents/inventory_cost_adjustments/$(adjustmentId);
      return adjustmentId is string
        && !exists(adjustmentPath)
        && existsAfter(adjustmentPath)
        && getAfter(adjustmentPath).data.product_id == productId
        && getAfter(adjustmentPath).data.new_cost == request.resource.data.cost_price;
    }

    function hasProductMovementLink(productId, movementId) {
      let productPath = /databases/$(database)/documents/products/$(productId);
      return existsAfter(productPath)
        && getAfter(productPath).data.get('last_inventory_transaction_ids', []).hasAny([movementId]);
    }

    function validNewPurchaseInvoice() {
      let supplierId = request.resource.data.get('supplier_id', null);
      let supplierPath = /databases/$(database)/documents/suppliers/$(supplierId);
      return request.resource.data.keys().hasAll([
          'items', 'product_ids', 'total_amount', 'paid_amount', 'remaining_amount',
          'payment_ids', 'created_by', 'created_at'
        ])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.product_ids is list
        && request.resource.data.total_amount is number
        && request.resource.data.paid_amount is number
        && request.resource.data.remaining_amount is number
        && request.resource.data.paid_amount >= 0
        && request.resource.data.remaining_amount >= 0
        && request.resource.data.paid_amount <= request.resource.data.total_amount
        && request.resource.data.paid_amount + request.resource.data.remaining_amount >= request.resource.data.total_amount - 0.005
        && request.resource.data.paid_amount + request.resource.data.remaining_amount <= request.resource.data.total_amount + 0.005
        && request.resource.data.payment_ids is list
        && request.resource.data.payment_ids.size() == 0
        && (supplierId == null || (supplierId is string && exists(supplierPath)));
    }

    function validSupplierPaymentUpdate(invoiceId) {
      let paymentIds = request.resource.data.get('payment_ids', []);
      let paymentId = paymentIds[paymentIds.size() - 1];
      let paymentPath = /databases/$(database)/documents/supplier_payments/$(paymentId);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'paid_amount', 'remaining_amount', 'payment_ids'
        ])
        && paymentIds is list
        && paymentIds.size() == resource.data.payment_ids.size() + 1
        && request.resource.data.paid_amount is number
        && request.resource.data.remaining_amount is number
        && request.resource.data.paid_amount > resource.data.paid_amount
        && request.resource.data.remaining_amount < resource.data.remaining_amount
        && request.resource.data.remaining_amount >= 0
        && request.resource.data.paid_amount + request.resource.data.remaining_amount >= resource.data.total_amount - 0.005
        && request.resource.data.paid_amount + request.resource.data.remaining_amount <= resource.data.total_amount + 0.005
        && !exists(paymentPath)
        && existsAfter(paymentPath)
        && getAfter(paymentPath).data.purchase_invoice_id == invoiceId
        && getAfter(paymentPath).data.amount == request.resource.data.paid_amount - resource.data.paid_amount;
    }

    function validSupplierPaymentRecord(id) {
      let invoiceId = request.resource.data.get('purchase_invoice_id', null);
      let invoicePath = /databases/$(database)/documents/purchase_invoices/$(invoiceId);
      return request.resource.data.amount is number
        && request.resource.data.amount > 0
        && invoiceId is string
        && existsAfter(invoicePath)
        && getAfter(invoicePath).data.payment_ids.hasAny([id]);
    }

    match /invoices/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && validInvoice();
      allow update: if isStaff() && validInvoice();
      // deletes admin-only; bulk deleteOldInvoices must run server-side
      allow delete: if isAdmin();
    }
    match /products/{id} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.price is number
        && request.resource.data.cost_price is number
        && request.resource.data.get('stock_quantity', 0) is number
        && request.resource.data.get('stock_quantity', 0) >= 0
        && request.resource.data.get('low_stock_threshold', 5) is number
        && request.resource.data.get('low_stock_threshold', 5) >= 0;
      allow update: if isAdmin() || (isStaff()
        && (request.resource.data.get('stock_quantity', null) == resource.data.get('stock_quantity', null)
          || hasFreshInventoryMovement(id))
        && (request.resource.data.get('cost_price', null) == resource.data.get('cost_price', null)
          || hasFreshCostMovement(id)
          || hasFreshCostAdjustment(id))
        && (!('base_unit_id' in resource.data)
          || request.resource.data.get('base_unit_id', null) == resource.data.get('base_unit_id', null))
        && request.resource.data.get('low_stock_threshold', 5) is number
        && request.resource.data.get('low_stock_threshold', 5) >= 0);
      allow delete: if isAdmin();
    }
    match /customers/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /suppliers/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow delete: if isAdmin();
    }
    // Financial / accounting collections (F37). Audit records are
    // append-mostly: staff may read and create; only admin may correct
    // via compensating docs, never silent rewrites (delete = admin).
    match /cashbox/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['balance', 'updated_at'])
        && request.resource.data.balance is number
        && request.resource.data.balance >= 0;
      allow delete: if isAdmin();
    }
    match /cash_transactions/{id} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.direction in ['in', 'out'];
      allow update, delete: if isAdmin();
    }
    match /inventory_transactions/{id} {
      allow read: if isStaff();
      allow create: if isAdmin() || (isStaff()
        && request.resource.data.product_id is string
        && request.resource.data.quantity is number
        && request.resource.data.quantity > 0
        && request.resource.data.direction in ['in', 'out']
        && ((request.resource.data.get('purchase_invoice_id', null) is string
          && hasFreshPurchaseMovement(request.resource.data.product_id, request.resource.data.purchase_invoice_id))
          || hasProductMovementLink(request.resource.data.product_id, id)));
      allow update, delete: if isAdmin();
    }
    match /inventory_cost_adjustments/{id} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.product_id is string
        && request.resource.data.new_cost is number
        && existsAfter(/databases/$(database)/documents/products/$(request.resource.data.product_id))
        && getAfter(/databases/$(database)/documents/products/$(request.resource.data.product_id)).data.last_cost_adjustment_id == id
        && getAfter(/databases/$(database)/documents/products/$(request.resource.data.product_id)).data.cost_price == request.resource.data.new_cost;
      allow update, delete: if isAdmin();
    }
    match /invoice_returns/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }
    match /customer_loans/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /debt_payments/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }
    match /invoice_debt_summaries/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /purchase_invoices/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && validNewPurchaseInvoice();
      allow update: if isAdmin() || (isStaff() && (validSupplierPaymentUpdate(id)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned'])
          && request.resource.data.get('pinned', false) is bool));
      allow delete: if isAdmin();
    }
    match /supplier_payments/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && validSupplierPaymentRecord(id);
      allow update, delete: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
